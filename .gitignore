# ---------------------------------------------------------------- 系统 --
.DS_Store
Thumbs.db
.AppleDouble

# ---------------------------------------------------------------- Python --
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/

# ------------------------------------------------------- 运行时私有数据 --
# config/ 下是本机真实数据（节点地址、请求头、Cookie 等），不随仓库分发。
# 保留目录本身与示例文件，新克隆的仓库按 config/examples/README.md 引导。
config/*
!config/.gitkeep
!config/examples/
!config/examples/**

# 迁移前的旧 JSON（*.imported）同样是本机数据
*.imported
*.bak
*.bak.*

# ------------------------------------------------------------ 构建产物 --
dist/
build/
out/
*.pyz
*.spec

# ------------------------------------------------------------ 编辑器 --
.idea/
*.swp
.vscode/*
!.vscode/settings.json

# --------------------------------------------------------- 本地 AI 工具 --
# DSH 技能与本地规则，属于个人工作流配置，不属于产品产物
.dsh/
